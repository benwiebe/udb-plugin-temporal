{
  "display": { "type": "http", "width": 64, "height": 32, "scale": 8 },
  "datasources": [
    {
      "id": "calendar", "plugin": "udb-plugin-temporal", "datasourceId": "ical-calendar-events",
      "config": {
        "url": "https://example.com/calendar.ics", "timezone": "America/Toronto",
        "refreshSeconds": 300, "lookBackDays": 1, "lookAheadDays": 14, "maxEvents": 10, "maxBytes": 8388608
      }
    }
  ],
  "boards": [
